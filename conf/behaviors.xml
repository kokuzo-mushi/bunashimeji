<?xml version="1.0" encoding="UTF-8"?>
<Behaviors>

    <!-- ■ 基本的な振る舞い -->

    <!-- 地面にいて、何もしていない時、500フレームに1回くらいの確率で歩き始める -->
    <Behavior Name="Walk" Frequency="100">
        <Condition>mascot.isGrounded == true and mascot.currentAction == null and time % 500 == 0</Condition>
        <ActionReference Name="Walk" />
    </Behavior>

    <!-- 地面にいて、何もしていない時、歩き始めない場合は待機モーション -->
    <Behavior Name="Stay" Frequency="100">
        <Condition>mascot.isGrounded == true and mascot.currentAction == null</Condition>
        <ActionReference Name="Stay" />
    </Behavior>

    <!-- ■ 壁での折り返し -->

    <!-- 右の壁にぶつかったら向きを変える -->
    <Behavior Name="TurnRight" Frequency="100">
        <Condition>mascot.isHittingRightWall == true and mascot.lookRight == true</Condition>
        <ActionReference Name="Turn" />
    </Behavior>

    <!-- 左の壁にぶつかったら向きを変える -->
    <Behavior Name="TurnLeft" Frequency="100">
        <Condition>mascot.isHittingLeftWall == true and mascot.lookRight == false</Condition>
        <ActionReference Name="Turn" />
    </Behavior>

    <!-- ■ 落下と着地 -->

    <!-- 空中にいて、ドラッグされていない時は落下モーション -->
    <Behavior Name="Fall" Frequency="100">
        <Condition>mascot.isGrounded == false and mascot.isBeingDragged == false</Condition>
        <ActionReference Name="Fall" />
    </Behavior>

    <!-- 接地した瞬間に着地モーション -->
    <Behavior Name="Land" Frequency="100">
        <Condition>event.type == 'MASCOT_STATE_CHANGED' and event.payload.propertyName == 'isGrounded' and event.payload.newValue == true</Condition>
        <ActionReference Name="Land" />
    </Behavior>

    <!-- ■ マウス操作 -->

    <!-- ドラッグされている時はじたばたする -->
    <Behavior Name="Dragged" Frequency="100">
        <Condition>mascot.isBeingDragged == true</Condition>
        <ActionReference Name="Dragged" />
    </Behavior>

</Behaviors>